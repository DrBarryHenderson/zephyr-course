menuconfig LED_SUBSYSTEM
    bool "Led Subsystem"
    default y

if LED_SUBSYSTEM

menuconfig LED_ADVANCED
    bool "LED Advanced system"
    default n

menu "Expert settings"
    visible if LED_ADVANCED

config LED_DEBUG
    bool "Enable LED Debugging"

config CUSTOM_BLINK_PATTERN
    bool "Enable Custom Blink Pattern"

endmenu  # for Expert Settings

choice
    prompt "LED blink speed"
    default BLINK_TIME_1000MS

config BLINK_TIME_250MS
    bool "Fast"

config BLINK_TIME_1000MS
    bool "Medium"

config BLINK_TIME_2000MS
    bool "Slow"

endchoice

config BLINK_TIME_TIME_MS # we use this in main.c for example
    int # <-- no prompt = hidden variable
    default 250  if BLINK_TIME_250MS
    default 1000 if BLINK_TIME_1000MS
    default 2000 if BLINK_TIME_2000MS
    default 0

if LED_ADVANCED

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION_MS
    int "Fade duration (ms)"
    range 0 5000
    default 500

endif # LED_ADVANCED

endif # LED_SUBSYSTEM

# Timer for led0 overaly
config APP_HEARTBEAT_PERIOD_MS
    int "Timer for Heartbeat on led0(ms)"
    range 100 2000
    default 500

source "Kconfig.zephyr"

rsource "drivers/our_driver/Kconfig"
